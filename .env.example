# Copy to .env and fill in what you need. Nothing here is required: with no
# settings, Voicestage runs the built-in example server with the "scripted"
# provider, which needs no model. This file is read from the folder you start
# Voicestage in.

# Which model provider drives the assistants. Overrides assistant.provider in
# the configuration file. One of:
#   scripted | anthropic | bedrock | openai-compatible | claude-code
# VOICESTAGE_PROVIDER=scripted

# Model for the provider. Overrides assistant.model.
# VOICESTAGE_MODEL=

# --- anthropic ---------------------------------------------------------------
# ANTHROPIC_API_KEY=

# --- bedrock (Converse API) --------------------------------------------------
# Uses the standard AWS credential chain. Set a region and, in the configuration
# or VOICESTAGE_MODEL, a model or inference profile id that supports tool use.
# AWS_REGION=us-east-1
# AWS_PROFILE=

# --- openai-compatible -------------------------------------------------------
# Any Chat Completions server with tool calling, hosted or local.
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=

# --- claude-code -------------------------------------------------------------
# No key: uses the Claude Code login on this machine.

# --- Hold On example (examples/holdon) ---------------------------------------
# HOLDON_URL=http://localhost:8787
# HOLDON_DIR=../holdon
# HOLDON_MEMBER_TOKEN=demo-member-margaret
# HOLDON_CONTACT_TOKEN=demo-contact-sarah

# --- recording with Kokoro voices (scripts/tts/kokoro.py) ----------------------
# The folder that holds kokoro-v1.0.onnx and voices-v1.0.bin. See README.md,
# "Voices from another program".
# KOKORO_DIR=
