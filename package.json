{
  "name": "voicestage",
  "version": "0.1.0",
  "description": "A local stage for voice-first MCP apps: simulated smart displays, speakers and phones that talk to your Streamable HTTP MCP servers and Agent Skills, with MCP Apps cards, proactive announcements, a developer inspector and replayable scenarios. Unofficial; not affiliated with Amazon.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "voicestage": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "scenarios",
    "voicestage.config.yaml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts dev",
    "build": "tsc -p tsconfig.build.json && vite build",
    "prestart": "node scripts/ensure-build.mjs",
    "start": "node dist/cli.js start",
    "scenario": "tsx src/cli.ts scenario",
    "example-server": "tsx src/cli.ts example-server",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1149.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "express": "^5.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "puppeteer-core": "^25.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
